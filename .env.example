# Secrets are split per-service. Each service directory has its own .env.example
# where one is checked in. Copy <service>/.env.example to <service>/.env and
# fill in your values.
#
# Services with .env files (under services/):
#   services/traefik/.env         — CF_DNS_API_TOKEN, LETSENCRYPT_EMAIL, TRAEFIK_DASHBOARD_DOMAIN
#   services/searxng/.env         — SEARXNG_DOMAIN
#   services/adguard/.env         — ADGUARD_DOMAIN
#   services/wireguard/.env       — WG_HOST, WG_DOMAIN, WG_INIT_PASSWORD, WG_PUBLIC_IP
#   services/samba/.env           — SMB_FILES_PATH
#   services/paperless/.env       — PAPERLESS_*, TZ
#   services/vaultwarden/.env     — VAULTWARDEN_*
#   services/linkding/.env        — LINKDING_*
#   services/changedetection/.env — CHANGEDETECTION_DOMAIN
#   services/forgejo/.env         — FORGEJO_*
#   services/mealie/.env          — MEALIE_*, TZ
#   services/ntfy/.env            — NTFY_DOMAIN, TZ
#   services/portainer/.env       — PORTAINER_DOMAIN
#   services/matrix/.env          — MATRIX_*, LIVEKIT_*, LKJWT_DOMAIN
#   services/plex/.env            — PLEX_*, TZ
#   services/gluetun/.env         — MULLVAD_WG_*, TZ
#   services/qbittorrent/.env     — QBITTORRENT_DOMAIN, QBITTORRENT_DOWNLOADS_PATH, TZ
#   services/prowlarr/.env        — PROWLARR_DOMAIN, TZ
#   services/sonarr/.env          — SONARR_DOMAIN, SONARR_MEDIA_PATH, TZ
#   services/radarr/.env          — RADARR_DOMAIN, RADARR_MEDIA_PATH, TZ
#   services/overseerr/.env       — OVERSEERR_DOMAIN, TZ
#   services/flaresolverr/.env    — FLARESOLVERR_DOMAIN, TZ
#
# Other stacks have their own root-level .env:
#   games/.env                    — MODPACK, MOTD, ICON, LEVEL, MEMORY, DIFFICULTY, SRC_DIR, BK_DIR, WEB_*
