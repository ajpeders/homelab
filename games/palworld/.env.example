# Palworld Dedicated Server
# Game app ID: 2394010 (server) / 1623730 (game)

PUID=1000
PGID=1000

# Network
PORT=8211
PLAYERS=16
# Set true to list on the in-game community server browser. The compose file
# must also pass PUBLIC_IP/PUBLIC_PORT — without a real public IP the server
# auto-detects a private (Docker) address and the listing has nothing joinable
# to publish, so it never appears. See PUBLIC_IP below.
COMMUNITY=false
# Advertised address for the community listing. Leave PUBLIC_IP blank for a
# LAN-only / join-by-IP server; set it to the home public IPv4 when listing
# publicly. A literal IP goes stale if the ISP rotates it.
PUBLIC_IP=
PUBLIC_PORT=8211

# Identity
SERVER_NAME=The Whip
SERVER_DESCRIPTION=

# Secrets — set real values in .env (gitignored), leave blank here.
SERVER_PASSWORD=
ADMIN_PASSWORD=changeme

# Pull the latest Steam dedicated-server build on each (re)start. Pinned to
# FALSE 2026-08-12: the Steam server build can run AHEAD of the console
# (Xbox/PS5) clients, and Palworld's community browser filters by version — a
# server newer than the console can't be seen by it. Leaving this true let the
# nightly restart silently drift the version. Flip to true for a single restart
# to update deliberately, confirm the clients are on the same build, then pin
# again.
UPDATE_ON_BOOT=false
