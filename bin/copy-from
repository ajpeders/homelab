#!/usr/bin/env bash
# copy-from — seed this homelab from another machine via rsync over SSH.
#
# Usage:
#   bin/copy-from <ssh-target> [--dry-run] [--remote-path /path] [--include-acme]
#
# Examples:
#   bin/copy-from user@old-server                       # state + all .env files
#   bin/copy-from user@old-server --dry-run             # preview, no writes
#   bin/copy-from user@old-server --include-acme        # also copy traefik/acme.json
#
# What gets copied (under $REMOTE_PATH on the source → this repo locally):
#   - state/                  (excluding forgejo/runner/ and traefik/acme.json by default)
#   - every .env / .env.local under services/ apps/ games/
#
# What does NOT get copied:
#   - state/forgejo/runner/   (ephemeral CI cache)
#   - state/traefik/acme.json (Let's Encrypt regenerates it; pass --include-acme to override)
#   - share/media/            (not part of the homelab repo at all)
#
# Stop the destination stacks before running this if you can, to avoid corrupting
# live sqlite/postgres files mid-copy.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

TARGET=""
REMOTE_PATH="$REPO_DIR"   # assume the same layout on the source host
DRY_RUN=""
INCLUDE_ACME=0

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)       DRY_RUN="--dry-run"; shift ;;
    --remote-path)   REMOTE_PATH="$2"; shift 2 ;;
    --include-acme)  INCLUDE_ACME=1; shift ;;
    -h|--help)       sed -n '2,20p' "$0"; exit 0 ;;
    -*)              echo "unknown flag: $1" >&2; exit 2 ;;
    *)               TARGET="$1"; shift ;;
  esac
done

if [ -z "$TARGET" ]; then
  echo "usage: $0 <ssh-target> [--dry-run] [--remote-path /path] [--include-acme]" >&2
  exit 2
fi

c_step() { printf '\n\033[1;36m▸ %s\033[0m\n' "$*"; }
c_ok()   { printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
c_warn() { printf '  \033[1;33m!\033[0m %s\n' "$*" >&2; }
c_info() { printf '  %s\n' "$*"; }

SSH_CMD="ssh -o StrictHostKeyChecking=accept-new"

# ---------- preflight ----------
c_step "Preflight"
if ! $SSH_CMD "$TARGET" "test -d '$REMOTE_PATH/state'" 2>/dev/null; then
  c_warn "no '$REMOTE_PATH/state' on $TARGET — use --remote-path if your repo lives elsewhere."
  exit 1
fi
c_ok "$TARGET:$REMOTE_PATH/state present"

if [ -n "$DRY_RUN" ]; then
  c_warn "DRY RUN — no files will be written locally"
fi

# warn if local state isn't empty — we use --delete and that nukes anything not on source
if find state -maxdepth 2 -type f 2>/dev/null | grep -q .; then
  c_warn "local state/ is non-empty. rsync --delete will overwrite/remove files to match source."
  printf '  continue? [y/N] '
  read -r ans
  [[ "$ans" =~ ^[Yy]$ ]] || { echo "aborted."; exit 1; }
fi

# warn if any containers are running — copying live DBs risks corruption
if command -v docker >/dev/null 2>&1 && [ -n "$(docker ps -q 2>/dev/null)" ]; then
  c_warn "docker containers are running locally. Consider 'docker compose down' in services/ and games/ first."
  printf '  continue anyway? [y/N] '
  read -r ans
  [[ "$ans" =~ ^[Yy]$ ]] || { echo "aborted."; exit 1; }
fi

# ---------- state/ ----------
c_step "Copying state/ from $TARGET:$REMOTE_PATH/state/"
EXCLUDES=(--exclude='forgejo/runner/**' --exclude='backup.log')
[ "$INCLUDE_ACME" -eq 0 ] && EXCLUDES+=(--exclude='traefik/acme.json')

mkdir -p state
rsync -avz --delete $DRY_RUN --info=progress2 -e "$SSH_CMD" \
  "${EXCLUDES[@]}" \
  "$TARGET:$REMOTE_PATH/state/" state/
c_ok "state/ synced"

# ---------- .env files ----------
c_step "Copying .env files from $TARGET:$REMOTE_PATH/"
# build a file list on the remote (every .env / .env.local under services/, apps/, games/)
REMOTE_LIST=$($SSH_CMD "$TARGET" "cd '$REMOTE_PATH' && find services apps games -maxdepth 4 \\( -name '.env' -o -name '.env.local' \\) -type f 2>/dev/null" || true)

if [ -z "$REMOTE_LIST" ]; then
  c_warn "no .env files found on the source — skipping."
else
  COUNT=0
  while IFS= read -r rel; do
    [ -z "$rel" ] && continue
    mkdir -p "$(dirname "$rel")"
    rsync -avz $DRY_RUN -e "$SSH_CMD" "$TARGET:$REMOTE_PATH/$rel" "$rel" >/dev/null
    COUNT=$((COUNT + 1))
    c_info "+ $rel"
  done <<<"$REMOTE_LIST"
  c_ok "copied $COUNT .env file(s)"
fi

# ---------- summary ----------
c_step "Done"
cat <<EOF

Reminders:
  - state/traefik/acme.json was $([ "$INCLUDE_ACME" -eq 1 ] && echo "copied" || echo "skipped — Let's Encrypt will recreate it on first start").
  - Hostnames in .env (TRAEFIK domains, WG_HOST, etc.) may point at the old machine —
    grep and fix anything machine-specific before bringing services up.
  - Check file ownership inside state/ matches what each service expects (postgres,
    paperless, etc. care about UIDs).

EOF
