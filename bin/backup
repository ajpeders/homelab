#!/usr/bin/env bash
# NOTE: deliberately NOT using `set -e`. Each target (remote + local USB mirror)
# and each step handles its own failure, so one failing rsync can no longer
# abort the whole job — the symlink update + prune for the *other* target (and
# for the steps that did succeed) still run. We still exit non-zero at the end
# if any active target had an error, so systemd flags the run as failed.
set -uo pipefail

REPO="${HOMELAB_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
# Host config (SHARE_DIR, BACKUP_*) from services/.env; caller env wins.
. "$REPO/bin/lib/env.sh"
[[ -n "${SHARE_DIR:-}" ]] || { echo "[backup] SHARE_DIR unset (services/.env)" >&2; exit 1; }

# Remote target (rsync over SSH). BACKUP_REMOTE_HOST is an IP or host name —
# prefer a stable address (e.g. a Tailscale 100.x IP) over a LAN IP that can
# change. BACKUP_REMOTE_USER must own BACKUP_REMOTE_DIR on that box; another
# local account running this needs its key in THAT user's authorized_keys, plus
# passwordless `sudo rsync` locally (see /etc/sudoers.d/rsync-backup).
REMOTE="${BACKUP_REMOTE_HOST:?set BACKUP_REMOTE_HOST in services/.env}"
REMOTE_USER="${BACKUP_REMOTE_USER:-$(id -un)}"
REMOTE_DIR="${BACKUP_REMOTE_DIR:?set BACKUP_REMOTE_DIR in services/.env}"
DATE=$(date +%Y-%m-%d)
LATEST="$REMOTE_DIR/latest"
DEST="$REMOTE_DIR/$DATE"
SSH_KEY="${BACKUP_SSH_KEY:-$HOME/.ssh/id_ed25519}"
# Pin the target's host key and refuse on mismatch, rather than
# StrictHostKeyChecking=no which trusts any key (MITM-able). Seed it with:
#   ssh-keyscan -t ed25519,rsa <host> > <BACKUP_KNOWN_HOSTS file>
KNOWN_HOSTS="${BACKUP_KNOWN_HOSTS:-$HOME/.ssh/known_hosts}"
# Owner for files written to the local mirror (rsync runs under sudo): the
# account running the backup, so it can prune its own tree without sudo rm.
LOCAL_OWNER="${BACKUP_LOCAL_OWNER:-$(id -un):$(id -gn)}"
SSH_CMD="ssh -i $SSH_KEY -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$KNOWN_HOSTS"
KEEP=7   # daily snapshots to retain on the REMOTE target
VANILLA_KEEP=2   # minecraft world tarballs to retain per target (22G each —
                 # unpruned they quietly ate 108G of the target by 2026-09).
                 # Cut 3->2 on 2026-09-21: three pinned ~66G and held free
                 # space at the 50G guard, skipping the remote leg outright.

# Removable USB mirror keeps a longer, age-gated history, decoupled from the
# remote. A snapshot there is deleted only if BOTH hold: it is beyond the newest
# LOCAL_KEEP_MIN, AND it is older than LOCAL_AGE_DAYS. So the USB never drops
# below 14 snapshots and never deletes anything younger than 2 weeks — it just
# stops unbounded growth once you have >14 snapshots AND they age out.
LOCAL_KEEP_MIN=14
LOCAL_AGE_DAYS=14

# Large + reproducible state that is intentionally NOT part of DR. Shared by the
# remote and local-mirror state syncs.
#   forgejo/runner/**      — ephemeral CI cache
#   traefik/acme.json      — auto-regenerated by Let's Encrypt
#   ollama/models/blobs/** — multi-GB LLM weights, re-pullable via `ollama pull`
#                            (manifests are kept so you know what to re-pull)
#   traefik/logs/**        — access-log noise, not DR material; it grew to a
#                            single 3.9G file before rotation existed
#                            (bin/traefik-logrotate) and was the biggest thing
#                            in every snapshot
STATE_EXCLUDES=(
  --exclude="forgejo/runner/**"
  --exclude="traefik/acme.json"
  --exclude="traefik/logs/**"
  --exclude="ollama/models/blobs/**"
)

# Per-target success flags. A failed step flips its target's flag, which makes
# the remaining steps for that target no-op and leaves its 'latest' untouched.
REMOTE_OK=1
LOCAL_RUN_OK=1

# Local USB mirror at $BACKUP_USB_MOUNT — auto-skipped if unset or not mounted.
USB_MOUNT="${BACKUP_USB_MOUNT:-}"
LOCAL_ROOT="$USB_MOUNT/server-backups"
LOCAL_LATEST="$LOCAL_ROOT/latest"
LOCAL_DEST="$LOCAL_ROOT/$DATE"
LOCAL_OK=0
if [[ -n "$USB_MOUNT" ]] && mountpoint -q "$USB_MOUNT" 2>/dev/null; then
  LOCAL_OK=1
fi

echo "[backup] starting → $REMOTE:$DEST  (local mirror: $([[ $LOCAL_OK == 1 ]] && echo on:$LOCAL_DEST || echo off))"

# --- prune FIRST, so space is freed before we write today's snapshot ---
# Keep newest (KEEP-1): after today's snapshot lands we settle back at KEEP.
# `head -n -N` consumes all input (no SIGPIPE), so this is pipefail-safe. The
# current 'latest' target is always among the newest, so link-dest stays valid.
echo "[backup] pruning old snapshots (keep newest $((KEEP-1)) before adding today)..."
$SSH_CMD "$REMOTE_USER@$REMOTE" "find '$REMOTE_DIR' -maxdepth 1 -type d -name '????-??-??' | sort | head -n -$((KEEP-1)) | xargs -r rm -rf" \
  || echo "[backup] WARN: remote prune failed (continuing)"
if [[ $LOCAL_OK == 1 ]]; then
  # Age-gated prune for the removable (see LOCAL_KEEP_MIN/LOCAL_AGE_DAYS above).
  # Runs before today's snapshot lands, so the count is yesterday's.
  mapfile -t _snaps < <(find "$LOCAL_ROOT" -maxdepth 1 -type d -name '????-??-??' -printf '%f\n' | sort)
  _count=${#_snaps[@]}
  if (( _count > LOCAL_KEEP_MIN )); then
    _cutoff=$(date -d "$LOCAL_AGE_DAYS days ago" +%Y-%m-%d)
    _removable=$(( _count - LOCAL_KEEP_MIN ))   # oldest ones beyond the keep-floor
    for (( _i = 0; _i < _removable; _i++ )); do
      _d="${_snaps[_i]}"
      # ISO dates sort lexicographically, so a plain string compare = date compare.
      if [[ "$_d" < "$_cutoff" ]]; then
        echo "[backup] pruning USB snapshot $_d (>$LOCAL_AGE_DAYS days old, keeping newest $LOCAL_KEEP_MIN)"
        rm -rf "$LOCAL_ROOT/$_d" || echo "[backup] WARN: failed to remove $_d (continuing)"
      fi
    done
  else
    echo "[backup] USB mirror has $_count snapshots (≤ $LOCAL_KEEP_MIN) — nothing to prune"
  fi
fi

# --- space guards -------------------------------------------------------------
# Pruning is retention-first (age + count floors) and deliberately never deletes
# history to make room — so disk pressure must be surfaced, not absorbed. If a
# target can't fit a worst-case snapshot, skip THAT leg cleanly (its 'latest'
# stays put, the other leg still runs) and say so loudly. Sized for a full
# non-hardlinked snapshot: ~20G state + 22G world tarball + headroom.
# Learned 2026-09-12: a stray 130G Time Machine target inflated two snapshots,
# filled the USB, and three nightly runs died at mkdir with zero warning.
MIN_FREE_G="${BACKUP_MIN_FREE_G:-50}"
_space_alert() {  # <target-label> <free-G>
  $REPO/bin/ntfy-alert high floppy_disk "homelab: backup skipped ($1)" \
    "Only ${2}G free on $1 (need ${MIN_FREE_G}G for a worst-case snapshot). Leg skipped — find what grew, or prune." \
    || true
}
if [[ $REMOTE_OK == 1 ]]; then
  _rfree=$($SSH_CMD "$REMOTE_USER@$REMOTE" "df --output=avail -BG '$REMOTE_DIR' 2>/dev/null | tail -1 | tr -dc '0-9'" 2>/dev/null)
  # Guard only enforces when df actually answered — an unreachable box is the
  # mkdir step's problem, and an empty string must not read as "0G free".
  if [[ -n "$_rfree" ]] && (( _rfree < MIN_FREE_G )); then
    echo "[backup] ERROR: remote has only ${_rfree}G free (< ${MIN_FREE_G}G) — skipping remote target"
    _space_alert "$REMOTE:$REMOTE_DIR" "$_rfree"
    REMOTE_OK=0
  fi
fi
if [[ $LOCAL_OK == 1 ]]; then
  _lfree=$(df --output=avail -BG "$USB_MOUNT" 2>/dev/null | tail -1 | tr -dc '0-9')
  if [[ -n "$_lfree" ]] && (( _lfree < MIN_FREE_G )); then
    echo "[backup] ERROR: USB has only ${_lfree}G free (< ${MIN_FREE_G}G) — skipping local target"
    _space_alert "$USB_MOUNT" "$_lfree"
    LOCAL_RUN_OK=0
  fi
fi

# --- create destination dirs ---
$SSH_CMD "$REMOTE_USER@$REMOTE" "mkdir -p '$DEST/state' '$DEST/minecraft/vanilla/modpacks' '$DEST/minecraft/atm10/modpacks' '$DEST/samba' '$DEST/games/palworld' '$DEST/games/sons-of-the-forest' '$DEST/env' '$DEST/docs' '$REMOTE_DIR/vanilla' '$REMOTE_DIR/atm10' && chmod go-rwx '$DEST/env'" \
  || { echo "[backup] ERROR: cannot create remote dirs (perms? disk?) — skipping remote target"; REMOTE_OK=0; }
if [[ $LOCAL_OK == 1 ]]; then
  mkdir -p "$LOCAL_DEST/state" "$LOCAL_DEST/minecraft/vanilla/modpacks" "$LOCAL_DEST/minecraft/atm10/modpacks" "$LOCAL_DEST/samba" \
           "$LOCAL_DEST/games/palworld" "$LOCAL_DEST/games/sons-of-the-forest" \
           "$LOCAL_DEST/env" "$LOCAL_DEST/docs" "$LOCAL_ROOT/vanilla" \
    || { echo "[backup] ERROR: cannot create local mirror dirs — skipping local target"; LOCAL_RUN_OK=0; }
  chmod go-rwx "$LOCAL_DEST/env" 2>/dev/null || true
fi

# --- link-dest anchors (hardlink de-dup against the previous snapshot) ---
# rsync resolves --link-dest RELATIVE TO THE DESTINATION DIR, so the anchor must
# name the *matching subdir* of the previous snapshot: a leg writing into
# <snap>/samba/ needs --link-dest=<prev>/samba. Anchoring at the snapshot ROOT
# (what this did until 2026-09-17) made rsync look for <prev>/<relpath> — one
# level too high — match nothing, and silently write a FULL copy every night:
# ~12G/day on the USB, visible only as `Matched data: 0` in the stats and
# links=1 on files identical to yesterday's. So these hold only the previous
# snapshot's ROOT; _rsync/_rsync_local append each leg's own subpath.
LINK_ROOT=""
if [[ $REMOTE_OK == 1 ]] && $SSH_CMD "$REMOTE_USER@$REMOTE" "test -L '$LATEST'"; then
  LINK_ROOT="$LATEST"
fi
LOCAL_LINK_ROOT=""
if [[ $LOCAL_OK == 1 && $LOCAL_RUN_OK == 1 && -L "$LOCAL_LATEST" ]]; then
  # MUST be the RESOLVED path, not the 'latest' symlink itself: on the local leg
  # rsync silently declines a --link-dest that reaches through a symlink and
  # copies every file at full size instead — no warning, just `Matched data: 0`.
  # Verified 2026-09-19 with two otherwise-identical commands: anchor via the
  # symlink → links=1 + fresh inode; anchor resolved → links=2, same inode.
  # The remote leg is unaffected (the receiving rsync resolves the path there),
  # which is why it de-duped correctly while this leg wrote 4.5G every night.
  LOCAL_LINK_ROOT="$(readlink -f "$LOCAL_LATEST")"
  [[ -d "$LOCAL_LINK_ROOT" ]] || LOCAL_LINK_ROOT=""   # dangling 'latest' → no anchor
fi

# Remote rsync. On failure: log + flip REMOTE_OK (subsequent calls no-op), but
# do NOT abort — the local mirror and the prune/symlink logic still run.
_rsync() {
  [[ $REMOTE_OK == 1 ]] || return 0
  local src="${*: -2:1}"
  local dst="${*: -1}"
  echo "  src: $src"
  echo "  dst: $REMOTE:$dst"
  echo "  size: $(du -sh "$src" 2>/dev/null | cut -f1)"
  # Per-leg de-dup anchor: <prev snapshot>/<this leg's subpath under $DEST>.
  # Guarded on the dest actually living under $DEST, so a caller writing
  # elsewhere (e.g. the per-server world dirs) simply gets no link-dest.
  local ld=""
  if [[ -n "$LINK_ROOT" ]]; then
    local _p="${dst#*:}"                      # strip the user@host: prefix
    if [[ "$_p" == "$DEST"/* ]]; then
      local rel="${_p#"$DEST"/}"; rel="${rel%/}"
      ld="--link-dest=$LINK_ROOT/$rel"
      echo "  link-dest: $LINK_ROOT/$rel"
    fi
  fi
  sudo rsync -az --delete --info=stats2 -e "$SSH_CMD" $ld "$@"
  local rc=$?
  # rsync 24 = source files vanished mid-transfer (live container state: sockets,
  # WAL, rotating logs). Benign — everything else transferred fine. Not a failure.
  if [[ $rc == 24 ]]; then
    echo "[backup] note: files vanished during transfer of $src (rsync 24) — OK"
  elif [[ $rc != 0 ]]; then
    echo "[backup] ERROR: remote rsync failed for $src (rsync $rc) — skipping rest of remote target"; REMOTE_OK=0
  fi
}

# Local mirror counterpart: same source + excludes, different destination root.
# --chown=$LOCAL_OWNER makes dest files owned by the running account so it can manage the tree
# (rm/ln/find) without sudo.
_rsync_local() {
  [[ $LOCAL_OK == 1 && $LOCAL_RUN_OK == 1 ]] || return 0
  local dst="${*: -1}"  # local absolute path
  echo "  dst: $dst (local mirror)"
  local ld=""
  if [[ -n "$LOCAL_LINK_ROOT" && "$dst" == "$LOCAL_DEST"/* ]]; then
    local rel="${dst#"$LOCAL_DEST"/}"; rel="${rel%/}"
    ld="--link-dest=$LOCAL_LINK_ROOT/$rel"
    echo "  link-dest: $LOCAL_LINK_ROOT/$rel (local mirror)"
  fi
  sudo rsync -az --delete --info=stats2 --chown="$LOCAL_OWNER" $ld "$@"
  local rc=$?
  if [[ $rc == 24 ]]; then
    echo "[backup] note: files vanished during local mirror of $dst (rsync 24) — OK"
  elif [[ $rc != 0 ]]; then
    echo "[backup] ERROR: local mirror rsync failed (rsync $rc) — skipping rest of local target"; LOCAL_RUN_OK=0
  fi
}

echo "[backup] services state..."
_rsync \
  "${STATE_EXCLUDES[@]}" \
  $REPO/state/ "$REMOTE_USER@$REMOTE:$DEST/state"
_rsync_local \
  "${STATE_EXCLUDES[@]}" \
  $REPO/state/ "$LOCAL_DEST/state/"

# Minecraft world tarballs, one leg per server (2026-09-05 split into
# vanilla/ + atm10/, each with its own mc-backups dir — vanilla's is a symlink
# to a legacy dir outside the repo). Newest tarball per server, kept in a
# PER-SERVER dir on each target: both servers name their files world-*, so a
# shared dir would let the keep-N prune eat one server's entire history.
# Both extensions: itzg/mc-backup wrote .tgz historically, .tar.gz since 2026-09.
# Prune world tarballs in <dir> to the newest <keep>. Emitted as a shell snippet
# so the local leg and the ssh leg run byte-identical logic instead of two
# hand-maintained copies.
#
# NUL-safe on purpose: the old `ls -t | tail | xargs -r rm -f --` word-split any
# name containing a space, `rm -f` then returned 0 on the fragments, and the
# `|| WARN` never fired — a silent no-op indistinguishable from success. Also
# scoped to `world-*` so a file parked in the dir by hand is never eaten.
# Built with a literal '%s' format: putting the pipeline in printf's FORMAT
# argument makes printf eat the `\0` that find needs, truncating the command
# mid-quote.
_prune_snippet() {  # <dir> <keep>
  local dir; printf -v dir '%q' "$1"
  printf '%s' "find $dir -maxdepth 1 -type f -name 'world-*' -printf '%T@ %p\\0'\
 | sort -zrn | tail -z -n +$(( $2 + 1 )) | sed -zE 's/^[0-9.]+ //'\
 | xargs -0r rm -f --"
}
_count_snippet() {  # <dir>
  local dir; printf -v dir '%q' "$1"
  printf '%s' "find $dir -maxdepth 1 -type f -name 'world-*' -printf x | wc -c"
}
# The 87G incident was not that the prune failed — it was that it failed
# quietly for months. Retention is cheap to check, so assert it instead of
# assuming, and make a breach loud enough to act on.
_prune_verify() {  # <label> <remaining-count>
  local label="$1" n="$2"
  [[ "$n" =~ ^[0-9]+$ ]] || { echo "[backup] WARN: could not verify prune for $label"; return 0; }
  if (( n > VANILLA_KEEP )); then
    echo "[backup] ERROR: $label still holds $n world tarballs (keep=$VANILLA_KEEP) — prune is not working"
    $REPO/bin/ntfy-alert high floppy_disk "homelab: world-backup prune failing" \
      "$label holds $n tarballs, expected <= $VANILLA_KEEP (~22G each). Check permissions on that dir." \
      || true
  fi
}

_mc_leg() {  # <server-name> <src-dir>
  local name="$1" src="$2" latest
  latest=$(ls -t "$src"/*.tgz "$src"/*.tar.gz 2>/dev/null | head -1)
  if [[ -z "$latest" ]]; then
    echo "  ($name: no world tarballs in $src — skipping)"
    return 0
  fi
  echo "  $name latest: $latest ($(du -sh "$latest" | cut -f1))"
  if [[ $REMOTE_OK == 1 ]]; then
    sudo rsync -az --delete --info=stats2 -e "$SSH_CMD" \
      --include="$(basename "$latest")" --exclude='*' \
      "$src/" "$REMOTE_USER@$REMOTE:$REMOTE_DIR/$name/" \
      || { echo "[backup] ERROR: remote $name world rsync failed"; REMOTE_OK=0; }
    # rsync's --exclude='*' protects existing receiver files from --delete, so
    # the dir only ever grows — prune to the newest VANILLA_KEEP explicitly.
    if [[ $REMOTE_OK == 1 ]]; then
      $SSH_CMD "$REMOTE_USER@$REMOTE" "$(_prune_snippet "$REMOTE_DIR/$name" "$VANILLA_KEEP")" \
        || echo "[backup] WARN: remote $name prune failed (non-fatal)"
      _prune_verify "$REMOTE:$REMOTE_DIR/$name" \
        "$($SSH_CMD "$REMOTE_USER@$REMOTE" "$(_count_snippet "$REMOTE_DIR/$name")" 2>/dev/null)"
    fi
  fi
  if [[ $LOCAL_OK == 1 && $LOCAL_RUN_OK == 1 ]]; then
    # No sudo on mkdir/rm: the sudoers grant is rsync-only, so `sudo rm` here
    # failed on every run once the dir exceeded VANILLA_KEEP and — with no
    # `set -e` and only a non-fatal WARN — did so in silence, leaving 4 x 22G
    # vanilla tarballs on the USB. The backup account owns $LOCAL_ROOT and the per-server dir,
    # so plain mkdir/rm work, exactly like the USB snapshot prune above.
    # NOTE this means the prune now depends on being run BY that account. Running the
    # script as another account (see BACKUP_SSH_KEY in the header) hits the ACL
    # mask on the per-server dir and cannot delete — which is why the prune is
    # verified below rather than trusted.
    mkdir -p "$LOCAL_ROOT/$name"
    sudo rsync -az --delete --info=stats2 --chown="$LOCAL_OWNER" \
      --include="$(basename "$latest")" --exclude='*' \
      "$src/" "$LOCAL_ROOT/$name/" \
      || { echo "[backup] ERROR: local $name world rsync failed"; LOCAL_RUN_OK=0; }
    if [[ $LOCAL_RUN_OK == 1 ]]; then
      bash -c "$(_prune_snippet "$LOCAL_ROOT/$name" "$VANILLA_KEEP")" \
        || echo "[backup] WARN: local $name prune failed (non-fatal)"
      _prune_verify "$LOCAL_ROOT/$name" \
        "$(bash -c "$(_count_snippet "$LOCAL_ROOT/$name")" 2>/dev/null)"
    fi
  fi
}
echo "[backup] minecraft world backups (newest per server)..."
_mc_leg vanilla "$REPO/games/minecraft/vanilla/mc-backups"
_mc_leg atm10   $REPO/games/minecraft/atm10/mc-backups

echo "[backup] minecraft modpacks..."
for _mp in $REPO/games/minecraft/*/modpacks; do
  [[ -d "$_mp" ]] || continue
  _srv=$(basename "$(dirname "$_mp")")
  _rsync       "$_mp/" "$REMOTE_USER@$REMOTE:$DEST/minecraft/$_srv/modpacks"
  _rsync_local "$_mp/" "$LOCAL_DEST/minecraft/$_srv/modpacks/"
done

# Palworld / Sons of the Forest keep their world state inside a multi-GB
# SteamCMD install (4.7G and 3.2G respectively) that is re-downloadable on
# demand, so only the irreplaceable bits are copied: saves, server config and
# (for palworld) the in-image 6-hourly backup tarballs. Together ~9M.
# Each path is guarded — a host without a given game installed must not flip
# that target's OK flag and skip everything after it.
echo "[backup] game world saves..."
_game_save() {  # $1 = absolute source dir   $2 = dest path under <snapshot>/games
  if [[ ! -d "$1" ]]; then
    echo "  (skip: $1 not present)"
    return 0
  fi
  echo "  $2 ($(du -sh "$1" 2>/dev/null | cut -f1))"
  _rsync       "$1/" "$REMOTE_USER@$REMOTE:$DEST/games/$2"
  _rsync_local "$1/" "$LOCAL_DEST/games/$2/"
}
# Palworld: Saved/ holds SaveGames + server Config; backups/ holds the
# in-container 6-hourly tarballs (BACKUP_CRON_EXPRESSION, 7-day retention).
_game_save $REPO/games/palworld/game/Pal/Saved   palworld/Saved
_game_save $REPO/games/palworld/game/backups     palworld/backups
# Sons of the Forest: userdata/ holds Saves/ plus dedicatedserver.cfg,
# SonsGameSettings.cfg and ownerswhitelist.txt.
_game_save $REPO/games/sons-of-the-forest/game/userdata \
           sons-of-the-forest/userdata

# .env files are the one thing that is in NEITHER git (gitignored, correctly --
# they are secrets) NOR state/. Without them a bare-metal rebuild restores every
# service's data and then cannot start a single stack. ~52 files, a few KB.
# Only literal `.env` is matched -- `.env.example` is already committed, and a
# narrow filter avoids sweeping up anything else that happens to sit alongside.
# `-m` prunes the empty dirs the `*/` include would otherwise create.
echo "[backup] .env secrets..."
# `--include='*/'` is recursive by nature, so without these the walk descends
# into every node_modules / .git / dist / build / SteamCMD install under apps/
# and games/ — measured 18s and ~26k directories traversed to find 8 files.
# These prune the walk itself (they precede the '*/' include; rsync takes the
# FIRST matching rule), and none of them is a plausible home for a real .env.
_ENV_PRUNE=(
  --exclude='node_modules/' --exclude='.git/' --exclude='__pycache__/'
  --exclude='.venv/' --exclude='venv/' --exclude='dist/' --exclude='build/'
  --exclude='.cache/' --exclude='.next/'
  --exclude='game/'          # palworld/sons-of-the-forest SteamCMD installs
)
_env_tree() {  # $1 = subdir of the repo to scan
  local src="$REPO/$1"
  if [[ ! -d "$src" ]]; then
    echo "  (skip: $1/ not present)"
    return 0
  fi
  # No -maxdepth: some .env files sit deeper than <stack>/<service>/ (e.g.
  # services/.env itself), and rsync's filter
  # below is recursive — the count must match what actually transfers.
  echo "  $1/ ($(find "$src" -name .env -type f 2>/dev/null | wc -l) files)"
  _rsync       -m "${_ENV_PRUNE[@]}" --include='*/' --include='.env' --exclude='*' \
    "$src/" "$REMOTE_USER@$REMOTE:$DEST/env/$1"
  _rsync_local -m "${_ENV_PRUNE[@]}" --include='*/' --include='.env' --exclude='*' \
    "$src/" "$LOCAL_DEST/env/$1/"
}
_env_tree services
_env_tree games
_env_tree apps
# Secrets at rest: keep the restored tree owner-only on both targets.
[[ $REMOTE_OK == 1 ]] && $SSH_CMD "$REMOTE_USER@$REMOTE" "chmod -R go-rwx '$DEST/env' 2>/dev/null" \
  || true
if [[ $LOCAL_OK == 1 && $LOCAL_RUN_OK == 1 ]]; then
  chmod -R go-rwx "$LOCAL_DEST/env" 2>/dev/null || true
fi

# Excluded from the samba leg, all large + reproducible or backups-of-backups:
#   media/**       — not part of DR (long-standing)
#   timemachine/** — a Mac's Time Machine target = already a backup; DR-ing it
#                    doubles 100G+ per snapshot for no recovery value
#   .Trash-*/, lost+found — filesystem noise
SAMBA_EXCLUDES=(
  --exclude="media/**"
  --exclude="timemachine/**"
  --exclude=".Trash-*/"
  --exclude="lost+found/"
)
echo "[backup] samba share (excluding media/, timemachine/)..."
_rsync \
  "${SAMBA_EXCLUDES[@]}" \
  "$SHARE_DIR"/ "$REMOTE_USER@$REMOTE:$DEST/samba"
_rsync_local \
  "${SAMBA_EXCLUDES[@]}" \
  "$SHARE_DIR"/ "$LOCAL_DEST/samba/"

# Update 'latest' ONLY for a target whose steps all succeeded — never advance the
# de-dup anchor onto a partial/failed snapshot.
if [[ $REMOTE_OK == 1 ]]; then
  $SSH_CMD "$REMOTE_USER@$REMOTE" "ln -sfn '$DEST' '$LATEST'" || echo "[backup] WARN: remote symlink update failed"
else
  echo "[backup] remote target had errors — leaving '$LATEST' unchanged"
fi
if [[ $LOCAL_OK == 1 ]]; then
  if [[ $LOCAL_RUN_OK == 1 ]]; then
    ln -sfn "$LOCAL_DEST" "$LOCAL_LATEST" || echo "[backup] WARN: local symlink update failed"
  else
    echo "[backup] local mirror had errors — leaving '$LOCAL_LATEST' unchanged"
  fi
fi

RC=0
[[ $REMOTE_OK == 1 ]] || RC=1
[[ $LOCAL_OK == 0 || $LOCAL_RUN_OK == 1 ]] || RC=1
if [[ $RC == 0 ]]; then
  echo "[backup] done"
else
  echo "[backup] done WITH ERRORS — see log above"
  # Fire an alert so a failed nightly run isn't silent. (A run that never
  # STARTS — e.g. the exit-209 log-ownership fault — is caught separately by
  # bin/monitor's backup-freshness check.) Never let alerting change the exit code.
  $REPO/bin/ntfy-alert high rotating_light "homelab: BACKUP FAILED" \
    "Nightly backup finished with errors on $(date '+%Y-%m-%d %H:%M %Z'). remote_ok=${REMOTE_OK} local_ok=${LOCAL_OK} local_run_ok=${LOCAL_RUN_OK}. See state/backup.log." || true
fi
exit $RC
