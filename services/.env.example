# Base domain. Every service hostname defaults to <sub>.${DOMAIN}; set a
# service's own *_DOMAIN in services/<svc>/.env only to override one.
# Also read by traefik's dynamic.yml ({{ env "DOMAIN" }}) and bin/ scripts.
DOMAIN=example.com

# Root of the shared storage tree. Media/download/export paths default to
# subdirs of it (media/, media/downloads, paperless, vpn); override one with
# that service's own *_PATH var.
SHARE_DIR=/srv/share

# Host account that owns media/downloads (`id -u` / `id -g`).
PUID=1000
PGID=1000

# Host LAN address + subnet (port binds, Plex/gluetun/WireGuard allowlists).
# LAN_IPV6_PREFIX: your LAN GUA /64 for traefik local-only; empty on v4-only.
LAN_IP=192.168.1.10
LAN_SUBNET=192.168.1.0/24
LAN_IPV6_PREFIX=

# Backup targets (bin/backup, bin/monitor). Remote = rsync over SSH; the remote
# user must own BACKUP_REMOTE_DIR. Seed the pinned host key with:
#   ssh-keyscan -t ed25519,rsa <host> > <BACKUP_KNOWN_HOSTS>
# BACKUP_USB_MOUNT is an optional second, local mirror (leave empty to skip).
BACKUP_REMOTE_HOST=100.64.0.10
BACKUP_REMOTE_USER=backup
BACKUP_REMOTE_DIR=/srv/backups
BACKUP_SSH_KEY=/home/backup/.ssh/id_ed25519
BACKUP_KNOWN_HOSTS=/home/backup/.ssh/known_hosts
BACKUP_USB_MOUNT=
# Disks bin/monitor watches + per-mount alert-% overrides ("mount=pct ...").
MONITOR_MOUNTS=/
MONITOR_DISK_OVERRIDES=

# Open WebUI: any OpenAI-compatible endpoint (llama.cpp, vLLM, Ollama /v1).
OPENWEBUI_LLM_URL=http://ollama:11434/v1

# Stack-wide compose env. `docker compose` auto-loads this when run from
# this directory. bin/install populates it based on host capabilities;
# uncomment lines manually if you skipped that step.

# COMPOSE_FILE chains overlays on top of the base compose. Use `:` between
# paths. The first file is the root; later files merge/override the earlier
# ones. Paths are relative to this directory.
#
# Pick the line that matches your host's encoder:
#
# `apps-mem-limits.yml` is NOT optional and NOT GPU-related: it carries the
# memory limits for every service whose compose lives in apps/. Leave it off and
# those containers come up unbounded, with nothing to tell you.
#
#   # CPU-only (default — libx264, works everywhere):
#   COMPOSE_FILE=docker-compose.yml:apps-mem-limits.yml
#
#   # NVIDIA GPU host (requires nvidia-container-toolkit):
#   COMPOSE_FILE=docker-compose.yml:jellyfin/docker-compose.gpu.yml:apps-mem-limits.yml
#
# bin/install runs `nvidia-smi` and `docker info` to detect the toolkit
# and writes the appropriate value here. It rewrites ONLY the COMPOSE_FILE
# line, so real secrets can live in services/.env alongside it safely.
