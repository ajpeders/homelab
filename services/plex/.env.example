# optional — defaults to plex.${DOMAIN}
# PLEX_DOMAIN=plex.example.com
# optional — defaults to ${LAN_IP}
# PLEX_LAN_IP=192.168.1.10
# optional — defaults to ${SHARE_DIR}/media
# PLEX_MEDIA_PATH=/srv/share/media
# Get a fresh claim at https://plex.tv/claim (valid 4 min, only used on first start)
PLEX_CLAIM=
# tz database name, e.g. America/New_York
TZ=Etc/UTC
