NTFY_DOMAIN=ntfy.yourdomain.com
# tz database name, e.g. America/New_York
TZ=Etc/UTC

# Host-side alerting (bin/ntfy-alert, bin/monitor, bin/backup). After first
# start, create a least-privilege token and paste it here:
#   docker exec ntfy ntfy user add --role=user alerter
#   docker exec ntfy ntfy access alerter homelab-alerts write-only
#   docker exec ntfy ntfy token add alerter
NTFY_ALERT_URL=http://127.0.0.1:8092
NTFY_ALERT_TOPIC=homelab-alerts
NTFY_ALERT_TOKEN=tk_replace_me
