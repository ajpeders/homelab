# Mullvad WireGuard config:
#   1. Log in at mullvad.net → WireGuard configuration
#   2. Generate a key and download the .conf for your chosen server
#   3. Copy values from the .conf file:
#      PrivateKey  → MULLVAD_WG_PRIVATE_KEY
#      Address     → MULLVAD_WG_ADDRESSES  (IPv4 only, e.g. 10.x.x.x/32)
# Gluetun uses its native Mullvad provider mode and selects a working endpoint.
MULLVAD_WG_PRIVATE_KEY=
MULLVAD_WG_ADDRESSES=10.x.x.x/32
MULLVAD_SERVER_COUNTRIES=USA
MULLVAD_SERVER_CITIES=Houston TX
# Standard Mullvad WireGuard DNS. Filtering DNS addresses like 100.64.0.7 can
# be used here, but have caused tunnel healthcheck DNS timeouts on this host.
MULLVAD_DNS_ADDRESS=10.64.0.1
# Used by qbittorrent's Traefik router label; set here because qbittorrent shares gluetun's network.
# optional — defaults to qbit.${DOMAIN}
# QBITTORRENT_DOMAIN=qbit.example.com
# tz database name, e.g. America/New_York
TZ=Etc/UTC
