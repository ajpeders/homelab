FORGEJO_DOMAIN=git.yourdomain.com
# Host LAN address for Forgejo SSH. Use VPN/LAN for Git-over-SSH.
# optional — defaults to ${LAN_IP}
# LAN_BIND_IP=192.168.1.10
FORGEJO_DB_PASSWORD=your_secure_password_here
# Runner registration token from Forgejo admin panel
FORGEJO_RUNNER_TOKEN=your_runner_token_here
