# optional — defaults to vm-debian.${DOMAIN}
# VM_DEBIAN_DOMAIN=vm-debian.example.com
VM_DEBIAN_RAM=3G
VM_DEBIAN_CORES=2
VM_DEBIAN_DISK=32G

# optional — defaults to vm-windows.${DOMAIN}
# VM_WINDOWS_DOMAIN=vm-windows.example.com
# See https://github.com/dockur/windows#how-do-i-select-the-windows-version for versions (11, 10, 2022, tiny11, ...)
VM_WINDOWS_VERSION=11
VM_WINDOWS_RAM=4G
VM_WINDOWS_CORES=4
VM_WINDOWS_DISK=64G

# optional — defaults to vm-macos.${DOMAIN}
# VM_MACOS_DOMAIN=vm-macos.example.com
# 15=Sequoia, 14=Sonoma, 13=Ventura
VM_MACOS_VERSION=15
VM_MACOS_RAM=4G
VM_MACOS_CORES=4
VM_MACOS_DISK=64G
